{
  "name": "khmer-wedding-invitation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "registry": "node scripts/build-registry-doc.ts",
    "check:heritage": "node scripts/check-heritage.ts",
    "qa": "node scripts/qa.mjs",
    "verify": "npm run typecheck && npx tsc -p worker/tsconfig.json && npm run check:heritage && npm run build",
    "media": "node scripts/process-media.mjs",
    "cf:dev": "npm run build && wrangler dev",
    "db:migrate": "wrangler d1 migrations apply wedding-blessings --remote",
    "deploy": "npm run verify && wrangler deploy",
    "db:backup": "mkdir -p backups && wrangler d1 export wedding-blessings --remote --output backups/blessings-$(date +%Y-%m-%d-%H%M).sql"
  },
  "dependencies": {
    "@fontsource/battambang": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/kantumruy-pro": "^5.3.0",
    "@fontsource/moul": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  }
}
